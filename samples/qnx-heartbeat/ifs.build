# Minimal QNX 8.0 IFS sketch for QEMU x86_64.
# This is a starting buildfile, not a full BSP. Combine it with the
# QNX SDP 8.0 / QNX Everywhere sample IFS for a bootable image.

[image=x86_64le]
[virtual=x86_64le,elf +compress] boot = {
    [bootstrap=x86_64]
    startup-x86
    PATH=/proc/boot ./procnto-smp-instr
}

[+script] startup-script = {
    display_msg schedgate pulse_heartbeat starting
    waitfor /dev/null
    devc-ser8250 -e
    waitfor /dev/ser1 4
    pulse_heartbeat &
}

[type=link] /bin/sh=/proc/boot/ksh
[uid=0 gid=0 perms=0755] pulse_heartbeat=/proc/boot/pulse_heartbeat
